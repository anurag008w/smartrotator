# SmartRotator — env template (local dev)
# Copy to .env ya environment me set karo. Render pe secret vars use karo.

# ── Config ────────────────────────────────────────────
ROTATOR_CONFIG=config.yaml

# ── Provider API keys (comma-separated) ───────────────
GEMINI_KEYS=
GROQ_KEYS=
OPENROUTER_KEYS=
ZEN_KEYS=

# ── Auth ──────────────────────────────────────────────
# Production me strong random string (32+ chars). Na do → data/.jwt-secret
# auto-generate hoga (chmod 600). Restart pe sessions survive karne ke liye
# env se DO.
JWT_SECRET=

# Optional: comma-separated usernames jo register pe auto-admin ho jayenge.
# Agar ye set hai, ADMIN_USERS me na hone wale kabhi admin nahi banenge.
ADMIN_USERS=

# ── At-rest encryption ────────────────────────────────
# Optional: API keys AES-256-GCM encrypt hokar data/*.json me save hote hain.
# Na do → data/.store-enc-key auto-generate. Dhyan: ye key lost ho to
# stored keys unrecoverable — production me env se dena best hai.
STORE_ENC_KEY=

# ── GitHub sync (data backup) ─────────────────────────
GITHUB_REPO=youruser/smartrotator-data
GH_TOKEN=
GITHUB_SYNC_ENABLED=true
GITHUB_SYNC_INTERVAL=180

# ── Data dir (default: ./data) ────────────────────────
# SMARTROTATOR_DATA_DIR=/path/to/data
